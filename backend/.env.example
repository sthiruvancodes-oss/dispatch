# Used by both the browser agent and the voice conversation.
OPENAI_API_KEY=

# --- Browser agent -----------------------------------------------------------
BROWSER_MODEL=gpt-4.1
# Keep this near zero: choosing which element to click is not a place for
# sampling variety. The voice agent runs at 0.7, separately.
BROWSER_TEMPERATURE=0.0

# Comma-separated domain patterns the agent may navigate to. Empty = unrestricted.
# Patterns: example.com, *.example.com, http*://example.com
# Required before any login below will be handed to the agent.
ALLOWED_DOMAINS=

# Optional nudge for when a task doesn't name a site. Empty = the task decides.
# Example: PREFERRED_SITES=wikipedia.org,news.ycombinator.com
PREFERRED_SITES=

# Overlays highlight what the agent is clicking. Nice in the live view, but they
# mutate the page the vision model reads. Set false if pages behave oddly.
HIGHLIGHT_ELEMENTS=true

# Give up on a run after this long, and on any single step after this long.
MAX_RUN_SECONDS=600
STEP_TIMEOUT_S=120

# Optional: attach to Chrome that's already open.
# Start Chrome with: --remote-debugging-port=9222
CHROME_CDP_URL=

# --- Site login (optional) ---------------------------------------------------
# Credentials are scoped to LOGIN_DOMAIN so they can't be typed into any other
# site. All three must be set, and ALLOWED_DOMAINS must cover LOGIN_DOMAIN,
# or the credentials are withheld. Cookies persist in backend/.browser-profile.
LOGIN_DOMAIN=
LOGIN_USERNAME=
LOGIN_PASSWORD=

# --- Phone -------------------------------------------------------------------
# Public HTTPS URL Twilio reaches this server on (Cloudflare Tunnel or ngrok).
PUBLIC_BASE_URL=

# Comma-separated E.164 numbers allowed to call in. Empty = reject every call.
# Example: ALLOWED_CALLERS=+15551234567
ALLOWED_CALLERS=

# Required: inbound webhooks are rejected unless the signature verifies.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# --- Voice pipeline ----------------------------------------------------------
# Deepgram runs speech-to-text, the LLM, and text-to-speech in one session.
DEEPGRAM_API_KEY=

# Flux does transcription and turn detection in one model.
VOICE_STT_MODEL=flux-general-en
# Confidence (0.5-1.0) needed to decide the caller has finished speaking.
# Raise it if the agent talks over people; lower it if replies feel slow.
VOICE_EOT_THRESHOLD=0.7
VOICE_EAGER_EOT_THRESHOLD=0.5
# Hard cap on waiting for a turn to end. Deepgram's default is 5000.
VOICE_EOT_TIMEOUT_MS=3000

# Deepgram TTS. version v2 is the Flux voices, v1 is Aura (e.g. aura-2-thalia-en).
VOICE_TTS_VERSION=v2
VOICE_TTS_MODEL=flux-kit-en

VOICE_LLM_MODEL=gpt-4.1
VOICE_LLM_TEMPERATURE=0.7
# Only needed if VOICE_LLM_MODEL isn't on Deepgram's hosted allowlist: point this
# at an OpenAI-compatible endpoint and OPENAI_API_KEY is sent as a bearer token.
VOICE_LLM_ENDPOINT=

VOICE_GREETING=Hey — what should I do in the browser?

# --- Web ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
